# Local development defaults
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=selfpi
API_HOST=0.0.0.0
API_PORT=8000
ENV=development
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Production (Docker / Railway / Fly / Render + Vercel)
# ---------------------------------------------------------------------------
# ENV=production
# MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=selfpi
# CORS_ORIGINS=https://your-app.vercel.app
# FRONTEND_URL=https://your-app.vercel.app
# # Public API origin used in GitHub App URLs (no trailing slash):
# #   Callback URL:  https://api.example.com/auth/github/callback
# #   Setup URL:     https://api.example.com/auth/github/installed
# GITHUB_OAUTH_REDIRECT_URI=https://api.example.com/auth/github/callback
# SESSION_SECRET=generate-a-long-random-string
# PORT is set by the host; uvicorn binds to it (default 8000).
# CHECKOUT_ROOT=/app/.cache/checkouts   # optional; clones are ephemeral on restart
#
# Cookie behavior: ENV=production (or https FRONTEND_URL) → Secure + SameSite=None
# so the Vercel origin can call the API with credentials:include.

# Anthropic — adjudicator + PR copy (optional; heuristic fallback without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# GitHub App — open fix PRs + list installation repos
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional single-tenant fallback. Leave empty for public Install App onboarding
# (users install from Settings; installation_id is stored on session / connected repo).
GITHUB_APP_INSTALLATION_ID=
# Optional; when empty, slug is fetched via GET /app (App JWT).
GITHUB_APP_SLUG=
GITHUB_DEFAULT_BASE_BRANCH=
# Leave empty to auto-detect each repo's default branch (main/master/…).

# Login with GitHub (OAuth) — required for production connect-repo
# From GitHub App → General: Client ID + generate Client secret
# Callback URL on the App must match GITHUB_OAUTH_REDIRECT_URI exactly
# Setup URL (Install App return): {API}/auth/github/installed
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
SESSION_SECRET=change-me-to-a-long-random-string
AUTH_REQUIRED=true

# Local checkout the scanner reads — leave empty in prod; connect clones to .cache/checkouts/
REPO_PATH=

# Optional: show stripe-demo harness on the dashboard (default false)
INCLUDE_DEMO_APIS=false

# Scheduled watcher — polls live watched APIs (not demo bump)
WATCH_ENABLED=true
WATCH_INTERVAL_SECONDS=300
