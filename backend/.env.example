# MongoDB — REQUIRED
# Local (default for `make` / `make mongo` — portable mongod, no Docker):
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=selfpi

# Atlas — only after Network Access allows your IP (or 0.0.0.0/0):
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority

API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_DEFAULT_BASE_BRANCH=main

